# Copy to backend/.env (or the repository root) and fill in your key.
# Get one at https://console.groq.com/keys — never commit the real file.
GROQ_API_KEY=

# Model used for every task. Run `python -m scripts.check_models` to list the
# models your key can access.
GROQ_MODEL=openai/gpt-oss-20b

# Optional per-task overrides (each falls back to GROQ_MODEL).
# GROQ_MODEL_ATS_CHECK=
# GROQ_MODEL_SKILLS=
# GROQ_MODEL_SCORING=
# GROQ_MODEL_RECOMMENDATIONS=
# GROQ_MODEL_REPORT=

# gpt-oss models reason before answering; keep the budget generous.
# Set GROQ_REASONING_EFFORT to empty for models that don't support it.
GROQ_MAX_TOKENS=3500
# The full audit report returns longer JSON, so it gets its own budget.
GROQ_REPORT_MAX_TOKENS=6000
GROQ_REASONING_EFFORT=low
# How often a call is retried when Groq rate-limits it (it waits in between).
GROQ_MAX_RETRIES=4

# Origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAX_UPLOAD_MB=5
